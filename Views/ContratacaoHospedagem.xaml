<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.ContratacaoHospedagem"
             Title="Cálculo da Diária"
             BackgroundColor="#F4F6F9">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">
            
            <!-- menu -->
            <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 8" Padding="6">
                <Grid ColumnDefinitions="*, *" ColumnSpacing="6">
                    <Button x:Name="btnTabReserva" Text="Reserva" 
                            Clicked="MostrarReserva_Clicked"
                            BackgroundColor="#0F172A" 
                            TextColor="White" 
                            CornerRadius="6" 
                            FontAttributes="Bold"
                            HeightRequest="40"/>
                    
                    <Button x:Name="btnTabSobre" Text="Sobre" 
                            Grid.Column="1" 
                            Clicked="MostrarSobre_Clicked"
                            BackgroundColor="#E2E8F0" 
                            TextColor="#1E293B" 
                            CornerRadius="6" 
                            FontAttributes="Bold"
                            HeightRequest="40"/>
                </Grid>
            </Border>
            <VerticalStackLayout x:Name="layoutReserva" Spacing="20" IsVisible="True">
                <Label Text="Reserva de Hospedagem" 
                       FontSize="24" 
                       FontAttributes="Bold" 
                       TextColor="#1E293B" 
                       HorizontalOptions="Center" 
                       Margin="0,5,0,5"/>

                
                <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 12" Padding="15">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="Quantidade de Hóspedes" FontAttributes="Bold" FontSize="16" TextColor="#334155"/>
                        
                      
                        <Grid ColumnDefinitions="*, 70, 42, 42" ColumnSpacing="6" VerticalOptions="Center">
                            <Label Text="Adultos (maiores de 12 anos)" VerticalOptions="Center" TextColor="#64748B"/>
                            <Border Grid.Column="1" Stroke="#CBD5E1" StrokeShape="RoundRectangle 6" BackgroundColor="#F8FAFC" HeightRequest="38" Padding="0">
                                <Label x:Name="lbl_val_adultos" Text="1" VerticalOptions="Center" HorizontalOptions="Center" FontAttributes="Bold" TextColor="#1E293B"/>
                            </Border>
                            <Button Grid.Column="2" Text="-" Clicked="RemoverAdulto_Clicked" BackgroundColor="#E2E8F0" TextColor="#1E293B" FontAttributes="Bold" CornerRadius="6" HeightRequest="38" Padding="0"/>
                            <Button Grid.Column="3" Text="+" Clicked="AdicionarAdulto_Clicked" BackgroundColor="#0F172A" TextColor="White" FontAttributes="Bold" CornerRadius="6" HeightRequest="38" Padding="0"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#F1F5F9"/>

                      
                        <Grid ColumnDefinitions="*, 70, 42, 42" ColumnSpacing="6" VerticalOptions="Center">
                            <Label Text="Crianças (até 12 anos)" VerticalOptions="Center" TextColor="#64748B"/>
                            <Border Grid.Column="1" Stroke="#CBD5E1" StrokeShape="RoundRectangle 6" BackgroundColor="#F8FAFC" HeightRequest="38" Padding="0">
                                <Label x:Name="lbl_val_criancas" Text="0" VerticalOptions="Center" HorizontalOptions="Center" FontAttributes="Bold" TextColor="#1E293B"/>
                            </Border>
                            <Button Grid.Column="2" Text="-" Clicked="RemoverCrianca_Clicked" BackgroundColor="#E2E8F0" TextColor="#1E293B" FontAttributes="Bold" CornerRadius="6" HeightRequest="38" Padding="0"/>
                            <Button Grid.Column="3" Text="+" Clicked="AdicionarCrianca_Clicked" BackgroundColor="#0F172A" TextColor="White" FontAttributes="Bold" CornerRadius="6" HeightRequest="38" Padding="0"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

             
                <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 12" Padding="15">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Escolha o tipo de Quarto" FontAttributes="Bold" FontSize="16" TextColor="#334155"/>
                        <Picker x:Name="pck_quarto" 
                                Title="Selecione o seu quarto" 
                                ItemDisplayBinding="{Binding Descricao}"
                                BackgroundColor="#F8FAFC"
                                TextColor="#1E293B"/>
                    </VerticalStackLayout>
                </Border>

            
                <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 12" Padding="15">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Período da Estadia" FontAttributes="Bold" FontSize="16" TextColor="#334155"/>
                        
                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto">
                            <Label Text="Data de Check-in:" VerticalOptions="Center" TextColor="#64748B"/>
                            <DatePicker x:Name="dtpck_checkin" 
                                        DateSelected="dtpck_checkin_DateSelected" 
                                        Grid.Column="1"
                                        TextColor="#1E293B"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#F1F5F9"/>

                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto">
                            <Label Text="Data de Check-out:" VerticalOptions="Center" TextColor="#64748B"/>
                            <DatePicker x:Name="dtpck_checkout" 
                                        Grid.Column="1"
                                        TextColor="#1E293B"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

               
                <Button Text="Calcular" 
                        Clicked="Button_Clicked"
                        BackgroundColor="#0F172A"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="16"
                        CornerRadius="10"
                        HeightRequest="50"
                        Margin="0,10,0,20"/>
            </VerticalStackLayout>

            <!--botao sobre-->
            <VerticalStackLayout x:Name="layoutSobre" Spacing="25" Padding="10" IsVisible="False">
                <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 12" Padding="30">
                    <VerticalStackLayout Spacing="20" HorizontalOptions="Center">
                        <Label Text="Sistema de Hospedagem" 
                               FontSize="24" 
                               FontAttributes="Bold" 
                               HorizontalOptions="Center" 
                               TextColor="#1E293B" />

                        <Label Text="App desenvolvido para cálculo de diárias de diárias de hoteis." 
                               FontSize="14"
                               HorizontalTextAlignment="Center" 
                               TextColor="#64748B" />

                        <BoxView HeightRequest="1" Color="#E2E8F0" Margin="10,0" />

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Informações do Desenvolvedor" 
                                   FontAttributes="Bold" 
                                   FontSize="16" 
                                   HorizontalOptions="Center" 
                                   TextColor="#1E293B"/>

                            <Label Text="Desenvolvedor por: Rafaela Alves de Lima" 
                                   FontSize="14" 
                                   HorizontalOptions="Center" 
                                   TextColor="#334155"/>

                            <Label Text="Ano: 2026" 
                                   FontSize="14" 
                                   HorizontalOptions="Center" 
                                   TextColor="#334155"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>