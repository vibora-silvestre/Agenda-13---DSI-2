<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.Sobre"
             Title="Sobre o Aplicativo"
             BackgroundColor="#F4F6F9">

    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="30" VerticalOptions="Center">
            
            <!-- menu -->
            <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 8" Padding="6" Margin="0,0,0,10">
                <Grid ColumnDefinitions="*, *" ColumnSpacing="6">
                    <Button Text="Reserva" 
                            Clicked="IrParaReserva_Clicked"
                            BackgroundColor="#E2E8F0" 
                            TextColor="#1E293B" 
                            CornerRadius="6" 
                            FontAttributes="Bold"
                            HeightRequest="40"/>
                    
                    <Button Text="Sobre" 
                            Grid.Column="1" 
                            BackgroundColor="#0F172A" 
                            TextColor="White" 
                            CornerRadius="6" 
                            FontAttributes="Bold"
                            HeightRequest="40"/>
                </Grid>
            </Border>

            <Image Source="dotnet_bot.png" 
                   WidthRequest="100" 
                   HeightRequest="100" 
                   HorizontalOptions="Center" />

            <Label Text="Sistema de Hospedagem" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   TextColor="#1E293B" />

            <Label Text="App desenvolvido para cálculo de diárias de hoteis." 
                   FontSize="14"
                   HorizontalTextAlignment="Center" 
                   TextColor="#64748B" />

            <BoxView HeightRequest="1" Color="#E2E8F0" Margin="10,0" />

            <VerticalStackLayout Spacing="6">
                <Label Text="Informações do Desenvolvedor" 
                       FontAttributes="Bold" 
                       FontSize="16" 
                       HorizontalOptions="Center" 
                       TextColor="#1E293B"/>

                <Label Text="Desenvolvido por: Rafaela Alves de Lima" 
                       FontSize="14" 
                       HorizontalOptions="Center" 
                       TextColor="#334155"/>

                <Label Text="Ano: 2026" 
                       FontSize="14" 
                       HorizontalOptions="Center" 
                       TextColor="#334155"/>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>